{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maktaba-al-fann/artworks.schema.json",
  "title": "Artwork records",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key",
      "artistKey",
      "title",
      "category",
      "availability",
      "dataSource"
    ],
    "properties": {
      "key": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "artistKey": {
        "type": "string"
      },
      "galleryKey": {
        "type": [
          "string",
          "null"
        ],
        "description": "Gallery offering or holding it, if any."
      },
      "title": {
        "type": "string"
      },
      "year": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1800,
        "maximum": 2100
      },
      "yearIsApprox": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "true for 'circa' dates."
      },
      "category": {
        "type": "string",
        "examples": [
          "Paintings",
          "Sculptures",
          "Drawings",
          "Printmaking",
          "Photography",
          "AI Assisted"
        ]
      },
      "style": {
        "type": [
          "string",
          "null"
        ],
        "description": "Empty = artist's style.",
        "examples": [
          "Impressionism",
          "Cubism",
          "Realism",
          "Abstract",
          "Expressionism",
          "Surrealism",
          "Minimalism",
          "Contemporary",
          "Mughal Miniature",
          "Folk Art"
        ]
      },
      "medium": {
        "type": [
          "string",
          "null"
        ],
        "description": "Free text as written by the gallery."
      },
      "paintMaterial": {
        "type": [
          "string",
          "null"
        ],
        "examples": [
          "Oil",
          "Acrylic",
          "Watercolour",
          "Gouache",
          "Ink",
          "Charcoal",
          "Pastel",
          "Tempera",
          "Gold Leaf",
          "Natural Pigments",
          "Mixed Media",
          "Bronze",
          "Marble",
          "Wood",
          "Resin",
          "Ceramic",
          "Steel"
        ]
      },
      "baseType": {
        "type": [
          "string",
          "null"
        ],
        "examples": [
          "Canvas",
          "Stretched canvas",
          "Gallery-wrap canvas",
          "Linen",
          "Paper",
          "Canvas board / panel",
          "Wasli Paper",
          "Rolled canvas",
          "Wood Panel",
          "Board",
          "Wasli",
          "Glass",
          "Metal",
          "Stone",
          "Hardboard / MDF",
          "Clay",
          "Fabric",
          "Wall / Plaster"
        ]
      },
      "theme": {
        "type": [
          "string",
          "null"
        ],
        "description": "Subject in a few words."
      },
      "shortDescription": {
        "type": [
          "string",
          "null"
        ]
      },
      "longDescription": {
        "type": [
          "string",
          "null"
        ],
        "description": "A few paragraphs about the artwork (blank line between paragraphs). Shown on the artwork page; the first lines appear on the home page."
      },
      "widthCm": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 1,
        "maximum": 5000
      },
      "heightCm": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 1,
        "maximum": 5000
      },
      "depthCm": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1000
      },
      "framed": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "availability": {
        "enum": [
          "for-sale",
          "on-request",
          "sold",
          "not-for-sale"
        ]
      },
      "price": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "description": "Asking price, numbers only."
      },
      "currency": {
        "enum": [
          "PKR",
          "USD",
          "GBP",
          "AED",
          "EUR",
          null,
          ""
        ]
      },
      "featured": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "true for the best pictures: shown in Stories from Pakistan and as the artist's picture."
      },
      "artistSlide": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "true = the picture used for this artist in the Artists page carousel (a landscape painting). Those artists are shown first."
      },
      "heldBy": {
        "type": [
          "string",
          "null"
        ],
        "description": "Museum or collection that owns it."
      },
      "imageUrl": {
        "type": [
          "string",
          "null"
        ],
        "anyOf": [
          {
            "format": "uri"
          },
          {
            "maxLength": 0
          }
        ]
      },
      "imageCredit": {
        "type": [
          "string",
          "null"
        ]
      },
      "imageLicense": {
        "enum": [
          "permission",
          "public-domain",
          "CC0",
          "CC BY",
          "CC BY-SA",
          "own",
          null,
          ""
        ],
        "description": "Required when imageUrl is set."
      },
      "dataSource": {
        "enum": [
          "web",
          "partner-gallery",
          "artist",
          "staff"
        ]
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "verified": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      },
      "madeUpFields": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Fields holding INVENTED test values (not real data). The importer refuses to load these into any database other than the local one. Replace them with real data and empty this list before going live."
      }
    }
  }
}
