# Copy to .env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/maktaba
PORT=8080
# Long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=
# 64 hex characters (openssl rand -hex 32) — encrypts stored contact details
DATA_ENCRYPTION_KEY=
# Admin console login (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Orders ───────────────────────────────────────────────
WHATSAPP_NUMBER=
# Public email shown in the footer and on the Contact page (optional)
CONTACT_EMAIL=
# Card payments (optional; card checkout is hidden when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications (optional) ─────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Optional ─────────────────────────────────────────────
# Natural-language artwork search
ANTHROPIC_API_KEY=
# Uploaded images folder (default: ./uploads). Docker sets /data.
UPLOAD_DIR=
# Extra front-end origins allowed to call the API (comma-separated)
CORS_ORIGINS=
LOG_LEVEL=info
